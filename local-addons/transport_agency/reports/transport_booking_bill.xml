<odoo>
    <!-- QWeb Template -->
    <template id="transport_booking_bill_template">
        <t t-call="web.external_layout">

            <main>
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <style>
    header, footer { display:none; }
    .page { padding-top:6px; }
                        </style>
                        <!-- ✅ TITLE -->
                        <h5 style="text-align:center; margin-bottom:10px;">
                        Booking Bill / Invoice
                        </h5>

                        <!-- ✅ BASIC INFO -->
                        <table width="100%" border="1" cellspacing="0" cellpadding="6" style="width:100%; margin-bottom:16px; border:1px solid #b0b0b0;">
                            <tr>
                                <td width="70%" style="padding:6px; ">
                                    <strong>M/s. Bhuban Enterprise</strong>
                                    <div>14/5, Marda Building, Bidhan Market, Siliguri, 734001 </div>
                                    <div>Phone: +919898989898</div>
                                    <div>GSTIN: GSTN34534U43</div>
                                </td>

                                <td width="30%" style="padding:6px; ">
                                    <div>Invoice No: INV-001</div>
                                    <div>Date: 01-12-2025</div>
                                    <div>Booking No: LR/25/2541</div>
                                    <div>Docket No: 74-X4521</div>
                                </td>
                            </tr>
                        </table>

                        <!-- ✅ CONSIGNEE/CONSIGNOR INFO -->
                        <table style="width:100%; margin-bottom:16px; font-size:14px; border:1px solid #b0b0b0;">
                            <tr style="background:#f2f2f2;">
                                <td width="50%" style="padding:6px; font-weight:700;">
                                    <strong>Consignor (Sender)</strong>
                                </td>
                                <td width="50%" style="padding:6px; font-weight:700;">
                                    <strong>Consignee (Receiver)</strong>
                                </td>
                            </tr>
                            <tr>
                                <td width="50%" style="padding:6px;">
                                    M/s. Bhuban Enterprise
                                    Bidhan Market, Siliguri - 734001
                                    <div>GSTIN: GSTN2384320432</div>
                                </td>
                                <td width="50%" style="padding:6px;">
                                    Bijoy Electronics
                                    Chowpathi, Alipurduar- 734005
                                    <div>GSTIN: GST2342304U675</div>
                                </td>
                            </tr>
                        </table>


                        <!-- ✅ CUSTOMER DETAILS -->
                        <table style="width:100%; font-size:13px; margin-bottom:16px; border:1px solid #b0b0b0;">
                            <tr style="background:#f2f2f2;">
                                <td style="padding:6px; width:30%;">
                                    <strong>Good Information</strong>
                                </td>
                                <td style="padding:6px;">
                                    <strong>Invoice</strong>
                                </td>
                                <td style="padding:6px;">
                                    <strong>Qty</strong>
                                </td>

                                <td style="padding:6px;">
                                    <strong>Weight</strong>
                                </td>
                                <td style="padding:6px;">
                                    <strong>Unit</strong>
                                </td>
                                <td style="padding:6px;text-align:right;">
                                    <strong>Value</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px; width:30%;">Box of Medicine</td>
                                <td style="padding:6px;">INV-564254</td>
                                <td style="padding:6px;">125</td>
                                <td style="padding:6px;">75</td>
                                <td style="padding:6px;">Kg</td>
                                <td style="padding:6px;text-align:right;">7,76,125.52</td>
                            </tr>

                        </table>

                        <!-- ✅ AMOUNT SUMMARY -->
                        <table style="width:25%; font-size:13px; margin-left:auto; border:1px solid #b0b0b0;">
                            <tr style="background:#f2f2f2;">
                                <td colspan="2" style="padding:6px; font-weight:700;">
                                Amount Summary
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px;">Total Amount</td>
                                <td style="padding:6px; text-align:right;">
                                ₹                                    <t t-esc="doc.total_amount"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px;">GST (5%)</td>
                                <td style="padding:6px; text-align:right;">126.50</td>
                            </tr>
                            <tr>
                                <td style="padding:6px;">Docket Charge</td>
                                <td style="padding:6px; text-align:right;">100.00</td>
                            </tr>
                            <tr>
                                <td style="padding:6px;">Fuel Charge</td>
                                <td style="padding:6px; text-align:right;">2,126.50</td>
                            </tr>
                            <tr>
                                <td style="padding:6px;">Advance Paid</td>
                                <td style="padding:6px; text-align:right;">
                                ₹                                    <t t-esc="doc.advance_amount"/>
                                </td>
                            </tr>
                            <tr style="font-weight:700; border-top:1px solid #b0b0b0;">
                                <td style="padding:6px;">Balance Due</td>
                                <td style="padding:6px; text-align:right; color:#d32f2f;">
                                ₹                                    <t t-esc="doc.balance_amount"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ✅ FOOTER NOTE -->
                        <p style="font-size:11px; margin-top:20px;">
                            <strong>Note:</strong> This is a system generated invoice.
                        </p>

                    </div>
                </t>
            </main>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_transport_booking_bill" model="ir.actions.report">
        <field name="name">Transport Booking Bill</field>
        <field name="model">transport.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_agency.transport_booking_bill_template</field>
        <field name="report_file">transport_agency.transport_booking_bill_template</field>
        <field name="print_report_name">'Booking Bill - %s' % (object.name)</field>
    </record>

</odoo>
