<odoo>
    <record id="view_transport_delivery_wizard_form" model="ir.ui.view">
        <field name="name">transport.delivery.wizard.form</field>
        <field name="model">transport.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Delivery">
                <field name="is_delivered" invisible="1"/>
                <group>
                    <field name="booking_id" readonly="1"/>
                    <field name="pod_file" attrs="{'readonly': [('is_delivered', '=', True)]}"/>
                    <field name="received_by" attrs="{'readonly': [('is_delivered', '=', True)]}"/>
                    <field name="delivery_date" attrs="{'readonly': [('is_delivered', '=', True)]}"/>
                    <field name="remark" />
                </group>

                <footer>
                    <button name="action_confirm_delivery" string="Confirm Delivery" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
