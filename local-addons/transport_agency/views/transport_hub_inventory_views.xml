<odoo>

    <!-- ========================= -->
    <!-- Tree View (Ledger)        -->
    <!-- ========================= -->
    <record id="view_transport_hub_inventory_tree" model="ir.ui.view">
        <field name="name">transport.hub.inventory.tree</field>
        <field name="model">transport.hub.inventory</field>
        <field name="arch" type="xml">
            <tree string="Hub Inventory Ledger">
                <field name="name" string="ID#"/>
                <field name="hub_id"/>
                <field name="booking_id"/>
                <field name="movement_type"/>
                <field name="goods_type_id"/>
                <field name="qty"/>
                <field name="weight"/>
                <field name="unit_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="remarks"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Form View (Read-only)     -->
    <!-- ========================= -->
    <record id="view_transport_hub_inventory_form" model="ir.ui.view">
        <field name="name">transport.hub.inventory.form</field>
        <field name="model">transport.hub.inventory</field>
        <field name="arch" type="xml">
            <form string="Hub Inventory Entry">
                <sheet attrs="{'readonly': [('id', '!=', False)]}">

                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="hub_id"/>
                            <field name="movement_type"/>
                        </group>

                        <group>
                            <field name="booking_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>

                    <separator string="Goods Details"/>

                    <group>
                        <group>
                            <field name="goods_type_id"/>
                            <field name="goods_description"/>
                        </group>
                        <group>
                            <field name="qty"/>
                            <field name="unit_id"/>
                            <field name="weight"/>
                        </group>
                    </group>

                    <separator string="Movement"/>

                    <group>
                        <group>
                            <field name="source_location_id"/>
                        </group>
                        <group>
                            <field name="destination_location_id"/>
                        </group>
                    </group>

                    <separator string="Remarks"/>

                    <group>
                        <field name="remarks" nolabel="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

